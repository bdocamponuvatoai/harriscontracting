# Canonical origin for canonical URLs, Open Graph, sitemap.xml and robots.txt. No trailing slash.
# Unset: falls back to https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel, then http://localhost:3000.
SITE_URL=https://www.example.com

# "true" lets search engines index the site (requires a real SITE_URL; the build fails on localhost).
# Anything else keeps every page noindex and robots.txt disallowing everything.
SITE_INDEXABLE=false
